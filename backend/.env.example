# ==========================================
# STOCKSENSE AI - BACKEND ENVIRONMENT VARIABLES
# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file to git.
# ==========================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/stocksense-ai

# JWT Auth
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# AI Provider Configuration
# Choose one: "claude" | "openai" | "gemini" | "mock"
AI_PROVIDER=mock

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Market Data
# Set to "true" to attempt real API calls; "false" to always use demo data
USE_REAL_MARKET_DATA=false
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
